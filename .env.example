# ============================================================
# ShopEase Customer Support Conversational AI - Environment Configuration
# ============================================================

# Backend Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DEBUG=False

# Machine Learning & Vector Store Paths
MODEL_PATH=models/intent_pipeline.joblib
VECTOR_INDEX_PATH=models/knowledge_tfidf_matrix.joblib
CHUNKS_PATH=processed_data/knowledge_chunks.json

# Inference & Retrieval Thresholds
CONFIDENCE_THRESHOLD=0.55
RELEVANCE_THRESHOLD=0.04
MAX_RETRIEVAL_CHUNKS=3

# Optional External LLM Integration (Leave empty to use Grounded Local Extraction)
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Frontend API URL (Used during production build)
VITE_API_URL=http://localhost:8000/api
